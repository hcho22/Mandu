#!/usr/bin/env python3
"""gp-chrome: headless Chrome for a Gr0wthPilot run's screenshots and PDFs.

It runs outside the sandbox (Chrome cannot start inside it), so it enforces:
  - headless only, on a fresh throwaway profile in the run's cache folder, so no
    sign-in, cookie, or extension of the Founder's ever loads;
  - it opens only local pages, and never by a file:// URL: a file in the
    Candidate Package or the cache folder is served, with the rest of that
    folder (so `../` within it resolves), by an http server on 127.0.0.1 that
    gp-chrome runs for that one call and that refuses any path leaving that
    folder or entering a protected package (symlinks followed); an http page
    can neither frame, embed, nor read a local file. A file the page asked for
    and did not get is printed as a warning. An http URL
    the run gives must be on localhost or 127.0.0.1 with no userinfo,
    backslash, or whitespace; Chrome gets it rebuilt from the checked parts;
  - files it writes land only in the Candidate Package or the cache folder;
  - a page can still reach the network.

Commands:
  gp-chrome screenshot PAGE OUT.png WIDTHxHEIGHT [--scale N]
  gp-chrome pdf PAGE OUT.pdf
  gp-chrome measure FILE WIDTHxHEIGHT     prints a local page's scroll width at that viewport
  gp-chrome dom PAGE                      prints the DOM after scripts run

PAGE is a path or a file://, http://localhost:PORT, or http://127.0.0.1:PORT URL.
"""

import contextlib
import functools
import html
import http.server
import json
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import urllib.parse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "scripts"))
from gp_tools import ToolError, inside, load_config, require_inside  # noqa: E402

CHROME_CANDIDATES = [
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "/Applications/Chromium.app/Contents/MacOS/Chromium",
]
SIZE_RE = re.compile(r"(\d{2,5})x(\d{2,5})")


def chrome_binary():
    for path in CHROME_CANDIDATES:
        if Path(path).is_file():
            return path
    raise ToolError("Google Chrome is not installed")


def page_source(cfg, page):
    """A page Chrome may show: ("url", an http URL on localhost rebuilt from its
    checked host, port, path, and query, None) or ("file", a local page file,
    the Candidate Package or cache folder that holds it), which gp-chrome
    serves itself."""
    parsed = urllib.parse.urlsplit(page)
    if parsed.scheme in ("http", "https"):
        if parsed.scheme != "http" or re.search(r"[\s\\@]", page):
            raise ToolError("gp-chrome opens only http://localhost or http://127.0.0.1 pages, with no "
                            "userinfo, backslash, or whitespace, not %s" % page)
        try:
            port = parsed.port
        except ValueError:
            raise ToolError("bad port in %s" % page)
        host = (parsed.hostname or "").lower()
        if host not in ("localhost", "127.0.0.1") or parsed.netloc.lower() != host + (":%d" % port if port else ""):
            raise ToolError("gp-chrome opens only local pages, not %s" % page)
        return "url", urllib.parse.urlunsplit(("http", parsed.netloc.lower(), parsed.path or "/", parsed.query,
                                               "")), None
    if parsed.scheme == "file":
        path = urllib.parse.unquote(parsed.path)
    elif parsed.scheme == "":
        path = page
    else:
        raise ToolError("unsupported page %s" % page)
    resolved = require_inside(cfg, path, "page")
    if not resolved.is_file():
        raise ToolError("%s does not exist" % resolved)
    root = next(Path(cfg[name]).resolve() for name in ("work", "package")
                if cfg.get(name) and inside(resolved, cfg[name]))
    return "file", resolved, root


@contextlib.contextmanager
def served(root, protected=()):
    """An http server on 127.0.0.1 for one of the run's own folders (the
    Candidate Package or the cache folder), for the length of one Chrome call.
    It refuses a request whose path, symlinks followed, leaves that folder or
    enters a protected package, and an http page cannot load file:// content.
    Each file the page asked for and did not get is printed as a warning."""
    root = Path(root).resolve()
    failed = []

    class Handler(http.server.SimpleHTTPRequestHandler):
        def send_head(self):
            target = Path(self.translate_path(self.path)).resolve()
            if not inside(target, root) or any(inside(target, p) for p in protected):
                self.send_error(403, "outside the run's own folder")
                return None
            return super().send_head()

        def log_request(self, code="-", size="-"):
            path = urllib.parse.unquote(urllib.parse.urlsplit(self.path).path)
            if code in (403, 404) and path != "/favicon.ico":
                failed.append("%s (HTTP %d)" % (path, code))

        def log_message(self, *args):
            pass

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), functools.partial(Handler, directory=str(root)))
    threading.Thread(target=server.serve_forever, daemon=True).start()
    try:
        yield "http://127.0.0.1:%d/" % server.server_address[1]
    finally:
        server.shutdown()
        server.server_close()
        for request in failed:
            print("gp-chrome: warning: the page asked for %s, which did not load" % request, file=sys.stderr)


@contextlib.contextmanager
def opened(cfg, page):
    """The URL Chrome opens for a page, for the length of one Chrome call."""
    kind, value, root = page_source(cfg, page)
    if kind == "url":
        yield value
        return
    with served(root, cfg.get("protected") or ()) as base:
        yield base + urllib.parse.quote(value.relative_to(root).as_posix())


def run_chrome(cfg, extra, url, timeout=120):
    profile = Path(tempfile.mkdtemp(prefix="chrome-", dir=str(Path(cfg["work"]))))
    args = [chrome_binary(), "--headless=new", "--user-data-dir=%s" % profile,
            "--no-first-run", "--no-default-browser-check", "--disable-extensions",
            "--disable-sync", "--disable-background-networking", "--disable-component-update",
            "--disable-default-apps", "--hide-scrollbars", "--mute-audio",
            "--virtual-time-budget=4000"] + extra + [url]
    try:
        proc = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              universal_newlines=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise ToolError("Chrome did not finish within %ds" % timeout)
    finally:
        shutil.rmtree(str(profile), ignore_errors=True)
    return proc


def size_arg(text):
    m = SIZE_RE.fullmatch(text)
    if not m:
        raise ToolError("size must be WIDTHxHEIGHT, such as 390x844")
    return int(m.group(1)), int(m.group(2))


def cmd_screenshot(cfg, args):
    """Shoots the page in an iframe of exactly WIDTHxHEIGHT inside a larger
    window, then crops the shot to the iframe (see the note above
    REPORT_SCRIPT): headless Chrome lays a page out at least about 500px wide
    and about 90px shorter than its window."""
    out = require_inside(cfg, args[1], "output")
    width, height = size_arg(args[2])
    scale = args[args.index("--scale") + 1] if "--scale" in args else "1"
    if scale not in ("1", "2", "3"):
        raise ToolError("--scale is 1, 2, or 3")
    out.parent.mkdir(parents=True, exist_ok=True)
    kind, page, root = page_source(cfg, args[0])
    if kind == "file":
        folder, src = page.parent, urllib.parse.quote(page.name)
    else:
        folder = root = Path(cfg["work"]).resolve()
        src = page
    wrapper = page_file(folder, ".gp-shot-wrap-", SHOT_PAGE % {"src": html.escape(src), "w": width, "h": height})
    shots = Path(tempfile.mkdtemp(prefix="shot-", dir=str(Path(cfg["work"]))))
    window = shots / "window.png"
    try:
        with served(root, cfg.get("protected") or ()) as base:
            proc = run_chrome(cfg, ["--window-size=%d,%d" % (max(width, 800), height + 100),
                                    "--force-device-scale-factor=%s" % scale, "--screenshot=%s" % window],
                              base + urllib.parse.quote(wrapper.relative_to(root).as_posix()))
        if not window.is_file():
            raise ToolError("Chrome wrote no screenshot: %s" % proc.stderr.strip()[-400:])
        try:
            subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(window), "-vf", "crop=%d:%d:0:0" % (
                width * int(scale), height * int(scale)), "-frames:v", "1", str(out)],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, check=True)
        except (OSError, subprocess.CalledProcessError) as exc:
            raise ToolError("could not crop the screenshot to %dx%d: %s"
                            % (width, height, (getattr(exc, "stderr", None) or str(exc)).strip()[-300:]))
    finally:
        wrapper.unlink()
        shutil.rmtree(str(shots), ignore_errors=True)
    if not out.is_file():
        raise ToolError("ffmpeg wrote no screenshot at %s" % out)
    print(str(out))


def cmd_pdf(cfg, args):
    out = require_inside(cfg, args[1], "output")
    out.parent.mkdir(parents=True, exist_ok=True)
    with opened(cfg, args[0]) as url:
        proc = run_chrome(cfg, ["--no-pdf-header-footer", "--print-to-pdf=%s" % out], url)
    if not out.is_file():
        raise ToolError("Chrome wrote no PDF: %s" % proc.stderr.strip()[-400:])
    print(str(out))


def cmd_dom(cfg, args):
    with opened(cfg, args[0]) as url:
        proc = run_chrome(cfg, ["--dump-dom"], url)
    sys.stdout.write(proc.stdout)


# Headless Chrome keeps a window of at least about 500px wide, and lays a page
# out about 90px shorter than the window, so the page is measured (and shot)
# inside an iframe of the exact viewport, whose layout and media queries follow
# the iframe's size, not the window's.
# The two commands fill that iframe differently.
# measure (a local page file only): the iframe holds a copy of the page
# written beside it (so its relative files still load) with a script that
# reports the page's size to the wrapper, also beside it, by postMessage; the
# wrapper writes the report into the DOM, which Chrome dumps.
# screenshot: the iframe loads the page itself, with no copy and no script,
# pinned to the window's top left; the wrapper sits beside a page file, or in
# the cache folder for a localhost URL, and ffmpeg crops the window's shot to
# the iframe.
# gp-chrome serves the wrapper, and a page file, like any other page.
REPORT_SCRIPT = """<script>
window.addEventListener('load', function () {
  setTimeout(function () {
    var d = document.documentElement, b = document.body;
    parent.postMessage(JSON.stringify({scrollWidth: Math.max(d.scrollWidth, b ? b.scrollWidth : 0),
                                       innerWidth: window.innerWidth, innerHeight: window.innerHeight}), '*');
  }, 500);
});
</script>
"""
WRAPPER_PAGE = """<!doctype html><html><head><meta charset="utf-8"></head>
<body style="margin:0"><iframe src="%(src)s" style="border:0;width:%(w)dpx;height:%(h)dpx"></iframe>
<script>
window.addEventListener('message', function (event) {
  var out = document.createElement('pre'); out.id = 'gp-measure';
  out.textContent = String(event.data);
  document.body.appendChild(out);
});
</script></body></html>
"""
SHOT_PAGE = """<!doctype html><html><head><meta charset="utf-8"></head>
<body style="margin:0"><iframe src="%(src)s"
style="position:fixed;top:0;left:0;border:0;width:%(w)dpx;height:%(h)dpx"></iframe></body></html>
"""


def with_report(text):
    """The page's HTML with the size-reporting script before its </body>."""
    at = text.lower().rfind("</body>")
    return text + REPORT_SCRIPT if at == -1 else text[:at] + REPORT_SCRIPT + text[at:]


def page_file(folder, prefix, text):
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=str(folder), prefix=prefix, suffix=".html",
                                     delete=False) as handle:
        handle.write(text)
    return Path(handle.name)


def cmd_measure(cfg, args):
    width, height = size_arg(args[1])
    kind, page, root = page_source(cfg, args[0])
    if kind != "file":
        raise ToolError("measure reads a local page file in the package or the cache folder, not %s" % args[0])
    copy = page_file(page.parent, ".gp-measure-", with_report(page.read_text(encoding="utf-8", errors="replace")))
    wrapper = page_file(page.parent, ".gp-measure-wrap-", WRAPPER_PAGE % {
        "src": html.escape(urllib.parse.quote(copy.name)), "w": width, "h": height})
    try:
        with served(root, cfg.get("protected") or ()) as base:
            proc = run_chrome(cfg, ["--window-size=%d,%d" % (max(width, 800), height + 100), "--dump-dom"],
                              base + urllib.parse.quote(wrapper.relative_to(root).as_posix()))
    finally:
        copy.unlink()
        wrapper.unlink()
    reports = re.findall(r'<pre id="gp-measure">([^<]+)</pre>', proc.stdout)
    try:
        data = json.loads(html.unescape(reports[-1]))
        data["overflows"] = data["scrollWidth"] > data["innerWidth"]
    except (IndexError, ValueError, KeyError, TypeError):
        raise ToolError("the page did not report its size: %s" % proc.stderr.strip()[-300:])
    data["viewport"] = "%dx%d" % (width, height)
    print(json.dumps(data))


COMMANDS = {"screenshot": (cmd_screenshot, 3), "pdf": (cmd_pdf, 2), "dom": (cmd_dom, 1),
            "measure": (cmd_measure, 2)}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print(__doc__)
        return 2
    func, minimum = COMMANDS[argv[0]]
    if len(argv) - 1 < minimum:
        print("gp-chrome %s needs %d argument(s)" % (argv[0], minimum), file=sys.stderr)
        return 2
    try:
        func(load_config(), argv[1:])
    except ToolError as exc:
        print("gp-chrome: %s" % exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
